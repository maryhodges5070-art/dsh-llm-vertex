{
  "name": "dsh-llm-vertex",
  "version": "0.1.0",
  "private": true,
  "description": "Google Cloud Vertex AI (Gemini) provider for DeepSeek Harness: ADC/service-account credentials, project + location, thought signatures, rate limiting and a settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "vertex-ai",
    "gemini",
    "google-cloud",
    "llm-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maryhodges5070-art/dsh-llm-vertex.git"
  },
  "homepage": "https://github.com/maryhodges5070-art/dsh-llm-vertex#readme",
  "bugs": {
    "url": "https://github.com/maryhodges5070-art/dsh-llm-vertex/issues"
  },
  "author": "maryhodges5070-art"
}
